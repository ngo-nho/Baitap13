<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================= -->
        <!-- TIÊU ĐỀ -->
        <!-- ============================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HỒ SƠ SINH VIÊN"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />


        <!-- ============================= -->
        <!-- CARD THÔNG TIN SINH VIÊN -->
        <!-- ============================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <!-- Avatar -->

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    android:contentDescription="Ảnh đại diện" />


                <!-- Tên -->

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngô Thị Nhớ"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />


                <!-- MSSV + lớp -->

                <TextView
                    android:id="@+id/tvStudentDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MSSV: 2415053122333 • Lớp: 24"
                    android:layout_marginTop="8dp" />


                <!-- Email -->

                <TextView
                    android:id="@+id/tvStudentEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email: sinhvien@ute.udn.vn"
                    android:layout_marginTop="6dp" />


                <!-- GPA -->

                <TextView
                    android:id="@+id/tvGpaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3.75 GPA • Xuất sắc"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />


                <!-- Danh hiệu -->

                <TextView
                    android:id="@+id/tvHonorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 Sinh viên xuất sắc"
                    android:textSize="16sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ============================= -->
        <!-- CARD CẬP NHẬT GPA -->
        <!-- ============================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tiêu đề -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CẬP NHẬT GPA"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />


                <!-- Nhập GPA -->

                <EditText
                    android:id="@+id/edtGpaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập GPA mới (0.0 - 4.0)"
                    android:inputType="numberDecimal"
                    android:text="3.75"
                    android:padding="12dp" />


                <!-- Nút cập nhật -->

                <Button
                    android:id="@+id/btnUpdateGpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CẬP NHẬT ĐIỂM GPA"
                    android:layout_marginTop="12dp" />


                <!-- Nút reset -->

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KHÔI PHỤC MẶC ĐỊNH"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>